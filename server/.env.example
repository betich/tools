# betich's tools — server
PORT=8787
DATA_DIR=./data

# Optional. Without it /api/fonts serves a small curated fallback list.
# https://developers.google.com/fonts/docs/developer_api
GOOGLE_FONTS_API_KEY=

ALLOWED_ORIGINS=http://localhost:5173,https://tools.betich.me
MAX_BATCH_ROWS=500
MAX_UPLOAD_BYTES=12582912

# Guard rails — defaults live in src/env.ts.
# MAX_BODY_BYTES=16777216       # any request body
# MAX_PROJECT_BYTES=8388608     # one saved doc + data
# MAX_PROJECTS=5000
# MAX_ASSET_BYTES=2147483648    # all uploads together
# MIN_FREE_BYTES=2147483648     # writes stop below this much free disk
# MAX_CANVAS_SIDE=8000
# MAX_LAYERS=100
# MAX_FAMILIES=12
# MAX_BATCH_PIXELS=2000000000   # rows x width x height
# MAX_BATCH_BYTES=536870912     # the ZIP, held in memory
# RENDER_CONCURRENCY=1
# RENDER_QUEUE=3
