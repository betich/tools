# betich's tools — server environment.
#
# The tunnel uses a credentials file (deploy/tunnel-credentials.json), created
# once with:  cloudflared tunnel create tools
# and routed with a CNAME from api.tools.betich.me to <tunnel-id>.cfargotunnel.com

# Optional. Without it the fonts endpoint resolves faces through the keyless
# CSS2 endpoint and serves a small curated catalogue for the picker.
GOOGLE_FONTS_API_KEY=

ALLOWED_ORIGINS=https://tools.betich.me,https://betich-tools.pages.dev,http://localhost:5173
MAX_BATCH_ROWS=500
MAX_UPLOAD_BYTES=12582912
